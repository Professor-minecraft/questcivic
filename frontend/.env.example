# ==========================================
# CivicQuest Frontend Environment Configuration
# ==========================================

# Backend API base URL (protocol + domain, without trailing slash).
# In development: defaults to http://localhost:8000 if omitted.
# In production on Vercel: set this to your deployed backend URL on Render
# Example: https://civicquest-backend.onrender.com
VITE_API_URL=http://localhost:8000

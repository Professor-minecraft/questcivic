# ==========================================
# CivicQuest Backend Environment Configuration
# ==========================================

# Application environment: "development" or "production"
# When set to "production", strict validation is enforced:
# - SECRET_KEY, ADMIN_PASSWORD, and AUDITOR_PASSWORD must be >= 12 characters and not default values.
# - BUILTIN_AUDITOR_ENABLED defaults to false unless explicitly set to true.
ENVIRONMENT=development

# JWT signing secret key (must be at least 12 random characters in production)
# Example production generation: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_MIN_12_CHARS

# Database connection URL.
# Local SQLite default: sqlite:///./app.db
# Production PostgreSQL (Supabase Session Pooler example):
# postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./app.db

# Allowed frontend origin(s) for CORS and link generation.
# Comma-separated list for multiple domains (e.g. https://civicquest.onrender.com,https://civicquest.vercel.app).
# Note: http://localhost:5173 is allowed only when ENVIRONMENT=development.
FRONTEND_ORIGIN=http://localhost:5173

# Built-in auditor credentials (used if BUILTIN_AUDITOR_ENABLED is true)
AUDITOR_ID=auditor
AUDITOR_PASSWORD=CHANGE_ME_AUDITOR_PASSWORD_MIN_12_CHARS

# Enable or disable the built-in auditor account.
# In development: defaults to true.
# In production: forced to false unless explicitly set to true.
BUILTIN_AUDITOR_ENABLED=true

# Admin staff account credentials
ADMIN_ID=civicquest-admin@gov.in
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_MIN_12_CHARS

# SMTP Mail configuration for OTPs, invites, and notifications.
# If SMTP_USER is blank, emails will be printed to server logs (dev mode).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER@gmail.com
SMTP_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD

# Domain restriction for citizen email signup/login (e.g. gmail.com)
ALLOWED_EMAIL_DOMAIN=gmail.com

# Gamification: XP points awarded upon auditor approval of a work submission
XP_PER_APPROVAL=150

# Gamification: XP points awarded upon auditor acceptance of a citizen complaint
XP_PER_COMPLAINT=50

# Maximum number of pending complaints a user can have active at one time
MAX_PENDING_COMPLAINTS=3

# Maximum file upload size for images (in megabytes)
MAX_UPLOAD_MB=8

# Path to the Lok Sabha constituencies GeoJSON file for boundary detection
GEOJSON_PATH=data/lok_sabha_constituencies.geojson

# Auditor invitation token validity duration (in hours)
INVITE_EXPIRE_HOURS=48

# One-time password (OTP) validity duration (in minutes)
OTP_EXPIRE_MINUTES=5

# Maximum verification attempts allowed per OTP
OTP_MAX_ATTEMPTS=5

# Maximum number of password reset requests permitted per email per day
RESET_REQUESTS_PER_DAY=2

# Maximum failed login attempts before temporary account lockout
LOGIN_MAX_ATTEMPTS=5

# Duration of temporary account lockout after failed attempts (in minutes)
LOGIN_LOCK_MINUTES=15

# Whether legacy passwordless OTP citizen login is enabled (false = password authentication)
LEGACY_OTP_LOGIN_ENABLED=false

# Minimum cooldown period between citizen profile location changes (in days)
LOCATION_CHANGE_DAYS=30
